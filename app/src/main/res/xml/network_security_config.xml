<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        本应用只使用 HTTP 访问同一台 Android 设备上的本地 MCP Server。
        MCP Server 只监听 127.0.0.1，不暴露到局域网或公网。
        使用 base-config 全局允许本应用访问本地明文 HTTP，
        避免某些设备上 IP 字面量（127.0.0.1）未被 domain-config 正确放行的问题。
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
